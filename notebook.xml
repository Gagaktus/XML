<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="text" encoding="UTF-8"/>

<xsl:template match="/">
    <xsl:text>Комплекс Курская: всего занятий </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[@complex='КУ'])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Комплекс ВДНХ: всего занятий </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[@complex='ВТ'])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Занятий в 10:00 </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[time='10:00'])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Занятий в 15:30 </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[time='15:30'])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Занятий в 17:20 </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[time='17:20'])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Первое занятие: </xsl:text>
    <xsl:value-of select="/timeTable/lessons/lesson[1]/thema"/>
    <xsl:text> состоялось </xsl:text>
    <xsl:value-of select="/timeTable/lessons/lesson[1]/date"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Последнее занятие: </xsl:text>
    <xsl:value-of select="/timeTable/lessons/lesson[last()]/thema"/>
    <xsl:text> состоялось </xsl:text>
    <xsl:value-of select="/timeTable/lessons/lesson[last()]/date"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Занятий по DTD </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[contains(thema, 'DTD')])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Чётных занятий на Курской </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[@complex='КУ'][number(@no) mod 2 = 0])"/>
    <xsl:text>&#10;</xsl:text>

    <xsl:text>Нечётных занятий на ВДНХ </xsl:text>
    <xsl:value-of select="count(/timeTable/lessons/lesson[@complex='ВТ'][number(@no) mod 2 = 1])"/>
    <xsl:text>&#10;</xsl:text>
</xsl:template>

</xsl:stylesheet>
